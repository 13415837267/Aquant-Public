{
  "schema_version": 2,
  "status": "current_research_architecture",
  "timezone": "Asia/Shanghai",
  "formal_cloud_runtime": "GitHub Actions",
  "strategy_source": {
    "repository": "13415837267/Aquant-Private",
    "branch": "main",
    "rule": "研究结果不得直接改写策略源；只有通过独立验证、最终留出、系统审计和正式发布后才允许进入生产模型资产。"
  },
  "hard_rules": {
    "signal": "T日收盘",
    "entry": "T+1开盘",
    "earliest_exit": "T+2",
    "max_holding_sessions": 5,
    "net_win_threshold_pct": 1,
    "stop_loss_pct": 3,
    "future_function": false,
    "timezone": "Asia/Shanghai"
  },
  "research_pipeline": [
    {
      "stage": 1,
      "name": "数据层",
      "modules": [
        "scripts/backfill_history.py",
        "scripts/refresh_universe.py",
        "scripts/pit_fundamentals.py"
      ],
      "outputs": [
        "data/history",
        "data/universe.json",
        "data/fundamentals"
      ]
    },
    {
      "stage": 2,
      "name": "特征与模型研究",
      "modules": [
        "scripts/train_short_term_model.py",
        "scripts/train_path_aware_model.py"
      ],
      "outputs": [
        "data/backtest/feature_training_latest.json",
        "data/backtest/path_aware_feature_training_latest.json",
        "data/backtest/path_aware_profit_3pct_training_latest.json"
      ],
      "rule": "研究模型使用2015-01至2026-09历史数据；当前实验以T+1开盘为入场，+3%止盈机会与T+2起-3%止损路径共同定义训练标签，T+1达到+3%计为成功机会；本轮在上一轮概率阈值0.70以上全部无入选样本后，采用正样本加权并扩大概率阈值诊断，同时增加每日Top2/Top5/Top10横截面排名评估；当前实验进一步加入基于市场广度的risk_off/neutral/risk_on三状态独立路由模型，使同一股票特征在不同市场状态下允许学习不同权重；研究结果不得直接改写正式生产模型。"
    },
    {
      "stage": 3,
      "name": "规则与高精度研究",
      "modules": [
        "scripts/path_rule_mining.py",
        "scripts/path_regime_rule_mining.py",
        "scripts/high_precision_profit_mining.py",
        "scripts/strict_path_strategy_score_mining.py"
      ],
      "outputs": [
        "data/backtest/path_rule_mining_latest.json",
        "data/backtest/path_regime_rule_mining_latest.json",
        "data/backtest/high_precision_profit_mining_latest.json"
      ]
    },
    {
      "stage": 4,
      "name": "正式历史验证",
      "modules": [
        "scripts/short_term_research.py",
        "scripts/short_term_release_validation.py"
      ],
      "outputs": [
        "data/backtest/short_term_latest.json",
        "data/backtest/short_term_sensitivity.json",
        "data/backtest/short_term_exit_diagnostics.json",
        "data/backtest/short_term_release_validation.json"
      ],
      "gate": "最终留出集、执行约束、未来函数和最小样本门槛必须全部通过；当前第一版质量门槛未通过。"
    },
    {
      "stage": 5,
      "name": "正式模型物化与候选生产",
      "modules": [
        "scripts/materialize_production_model.py",
        "scripts/production_model.py",
        "scripts/generate_research_candidates.py",
        "scripts/next_trading_day_plan.py"
      ],
      "outputs": [
        "data/models/production_v1.json",
        "data/candidates.json",
        "data/next_trading_day_plan.json"
      ],
      "rule": "生产日常只读取已发布固定模型，不每日重新训练。"
    },
    {
      "stage": 6,
      "name": "历史候选回放",
      "modules": [
        "scripts/generate_research_candidates.py"
      ],
      "outputs": [
        "data/research/historical_candidates"
      ],
      "rule": "固定模型加信号日数据截断，不读取未来行情。"
    },
    {
      "stage": 7,
      "name": "网页层",
      "modules": [
        "app/page.tsx"
      ],
      "rule": "只展示正式快照和状态，不自动下单。"
    }
  ],
  "isolation_rules": [
    "研究工作流不得把研究结果直接写入正式候选快照。",
    "生产候选不得每日重新训练模型。",
    "历史回放不得使用目标信号日之后的行情特征。",
    "候选池和下一交易日计划只允许一个权威候选快照。",
    "研究运行必须锁定Public与Private提交版本。",
    "研究失败不得把生产状态改写为已通过。",
    "旧研究结果只能作为历史审计资料，不得成为当前生产输入。"
  ]
}
